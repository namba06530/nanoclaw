# Dependencies
node_modules/
.npm-cache/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - only track base structure
# Note: CLAUDE.md files are intentionally excluded from git.
# They contain personal information (name, city, preferences) specific to each
# installation. Copy groups/global/CLAUDE.md.example as a starting point.
groups/*
!groups/main/
!groups/global/
groups/main/*
groups/global/*
!groups/global/CLAUDE.md.example

